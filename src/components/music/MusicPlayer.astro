---
import { MUSIC_ENABLED, TRACKS } from '../../config/music';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// 没有曲目时整块不渲染：不显示一个点了没反应的播放器
const tracks = MUSIC_ENABLED
  ? TRACKS.map((track) => ({ ...track, src: `${import.meta.env.BASE_URL}${track.src}` }))
  : [];
---
{
  tracks.length > 0 && (
    <aside class="player u-sans" data-music data-tracks={JSON.stringify(tracks)} aria-label={t(locale, 'music.label')}>
      <audio data-music-audio preload="none"></audio>

      <div class="player__row">
        <button
          type="button"
          class="player__button player__button--toggle"
          data-music-toggle
          data-label-play={t(locale, 'music.play')}
          data-label-pause={t(locale, 'music.pause')}
          aria-label={t(locale, 'music.play')}
        >
          <span data-music-icon aria-hidden="true">▶</span>
        </button>

        <button type="button" class="player__button" data-music-prev aria-label={t(locale, 'music.prev')}>
          <span aria-hidden="true">⏮</span>
        </button>
        <button type="button" class="player__button" data-music-next aria-label={t(locale, 'music.next')}>
          <span aria-hidden="true">⏭</span>
        </button>

        <span class="player__title" data-music-title></span>
        <span class="player__time u-muted" data-music-time>0:00</span>
      </div>

      <input
        class="player__range"
        type="range"
        min="0"
        max="1000"
        value="0"
        data-music-range
        aria-label={t(locale, 'music.label')}
      />
    </aside>
  )
}

<style>
  .player {
    position: fixed;
    inset-inline-end: var(--space-4);
    inset-block-end: var(--space-4);
    z-index: var(--z-overlay);
    width: min(22rem, calc(100vw - var(--space-8)));
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    background-color: var(--color-bg);
    border: var(--line-hair) solid var(--color-line);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
  }

  .player__row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .player__button {
    min-width: 2.25rem;
    min-height: 2.25rem;
    border-radius: var(--radius-sm);
    border: var(--line-hair) solid var(--color-line);
    color: var(--color-text);
  }

  .player__button:hover {
    border-color: var(--color-text);
  }

  .player__button--toggle {
    background-color: var(--color-invert-bg);
    color: var(--color-invert-text);
    border-color: var(--color-invert-bg);
  }

  .player__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .player__time {
    font-variant-numeric: tabular-nums;
  }

  .player__range {
    width: 100%;
    accent-color: var(--color-text);
  }

  /* 无 JS 时隐藏（没有脚本的播放器没有意义） */
  :global(html:not(.js) .player) {
    display: none;
  }
</style>

<script>
  import '../../scripts/music-player';
</script>
