---
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/base.css';
import { SITE_NAME } from '../config/site';
import {
  DEFAULT_LOCALE,
  LOCALE_CODES,
  getLocaleDefinition,
  type Locale,
} from '../i18n/config';
import { localeUrl } from '../i18n/url';
import { t } from '../i18n/ui';
import { assertContentIntegrity } from '../lib/content-integrity';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SearchOverlay from '../components/search/SearchOverlay.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** 版块路径（不含语言段）：用于语言切换与 hreflang */
  path?: string;
  /** 内容页用：按语言给出真实路径（不同语言可能不同 slug） */
  alternatePaths?: Partial<Record<Locale, string>>;
  /** 导航高亮用的路径；缺省与 path 相同。404 可传哨兵值表示不高亮 */
  navPath?: string;
  /** 该页面真实存在的语言；内容页传入，站点级页面默认全部语言 */
  availableLocales?: Locale[];
  /** 404 等页面不输出 alternates */
  showAlternates?: boolean;
  noindex?: boolean;
  /** 是否进入 Pagefind 搜索索引（只有内容详情页为 true，列表页不进索引以免重复命中） */
  indexable?: boolean;
}

const {
  locale,
  title,
  description,
  path = '',
  alternatePaths,
  navPath,
  availableLocales,
  showAlternates = true,
  noindex = false,
  indexable = false,
} = Astro.props;

// 内容完整性门禁：任何页面构建都会触发一次（模块内缓存）
await assertContentIntegrity();

const definition = getLocaleDefinition(locale);
const pageTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const pageDescription = description ?? t(locale, 'site.tagline');

const available = availableLocales ?? LOCALE_CODES;

// canonical：使用实际路径（已包含 base），保证与 URL 一字不差
const canonical = new URL(Astro.url.pathname, Astro.site);

// hreflang 只指向真实存在的语言版本，且用绝对地址；内容页按 alternatePaths 取真实 slug
const absolute = (code: Locale) =>
  new URL(localeUrl(code, alternatePaths?.[code] ?? path), Astro.site).href;
const alternates = available.map((code) => ({
  hreflang: getLocaleDefinition(code).htmlLang,
  href: absolute(code),
}));
const xDefaultHref = absolute(DEFAULT_LOCALE);
---
<!doctype html>
<html lang={definition.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    {
      showAlternates && (
        <>
          {alternates.map((item) => (
            <link rel="alternate" hreflang={item.hreflang} href={item.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
        </>
      )
    }
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:locale" content={definition.ogLocale} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // 首屏绘制前决定主题，避免闪白/闪黑（docs/design/color-and-theme.md）
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        var mode = 'system';
        try {
          var saved = localStorage.getItem('blog:theme');
          if (saved === 'light' || saved === 'dark' || saved === 'system') mode = saved;
        } catch (error) {
          /* 无法读取时退回 system */
        }
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = mode === 'system' ? (prefersDark ? 'dark' : 'light') : mode;
        root.dataset.themeMode = mode;
      })();
    </script>
  </head>
  <body data-pagefind-ignore={indexable ? undefined : ''}>
    <a class="skip-link" href="#main">{t(locale, 'skip.toContent')}</a>
    <SiteHeader
      locale={locale}
      navPath={navPath ?? path}
      switchPath={path}
      alternatePaths={alternatePaths}
      availableLocales={available}
    />
    <main id="main" class="main" data-pagefind-body={indexable ? '' : undefined}>
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <SearchOverlay locale={locale} mode="overlay" />
    <script>
      import '../scripts/theme';
    </script>
  </body>
</html>

<style>
  .main {
    display: block;
    padding-block: var(--space-16) var(--space-8);
  }
</style>
