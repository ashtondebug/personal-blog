---
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  locale: Locale;
  headings: Heading[];
}

const { locale, headings } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
---
{
  items.length > 1 && (
    <nav class="toc u-sans" data-toc aria-label={t(locale, 'toc.label')}>
      <p class="toc__label">{t(locale, 'toc.label')}</p>
      <ul role="list" class="toc__list">
        {items.map((heading) => (
          <li class={`toc__item toc__item--h${heading.depth}`}>
            <a class="toc__link" href={`#${heading.slug}`} data-toc-link={heading.slug}>
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<script>
  import '../../scripts/toc';
</script>

<style>
  .toc {
    display: grid;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .toc__label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
    padding-bottom: var(--space-2);
    border-bottom: var(--line-hair) solid var(--color-line);
  }

  .toc__list {
    display: grid;
    gap: var(--space-2);
  }

  .toc__link {
    color: var(--color-muted);
    text-decoration: none;
  }

  .toc__item--h3 {
    padding-inline-start: var(--space-3);
    font-size: var(--text-xs);
  }

  .toc__link:hover {
    color: var(--color-text);
  }

  .toc__link[aria-current='true'] {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 1100px) {
    .toc {
      position: sticky;
      top: calc(var(--space-16) + var(--space-8));
    }
  }
</style>
