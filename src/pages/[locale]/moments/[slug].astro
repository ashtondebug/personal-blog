---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { localeUrl } from '../../../i18n/url';
import { buildTranslations, byLocale, entryLocale, entrySlug, published, sortByDateDesc } from '../../../lib/content';
import { formatDate, isoDate } from '../../../lib/format';
import '../../../styles/prose.css';

type MomentEntry = Awaited<ReturnType<typeof getCollection<'moments'>>>[number];

export async function getStaticPaths() {
  const all = await getCollection('moments');
  return published(all).map((entry) => ({
    params: { locale: entryLocale(entry.id), slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: MomentEntry };
const locale: Locale = entryLocale(entry.id);
const { Content } = await render(entry);

const all = await getCollection('moments');
const siblings = sortByDateDesc(byLocale(published(all), locale));
const index = siblings.findIndex((item) => item.id === entry.id);
const newer = index > 0 ? siblings[index - 1] : undefined;
const older = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;

const translations = buildTranslations(all);
const group = entry.data.translationKey ? translations.get(entry.data.translationKey) : undefined;
const available = group ? [...group.keys()] : [locale];
const alternatePaths: Partial<Record<Locale, string>> = {};
if (group) {
  for (const [code, item] of group) alternatePaths[code] = `moments/${entrySlug(item.id)}`;
}
---
<BaseLayout
  locale={locale}
  path="moments"
  alternatePaths={alternatePaths}
  availableLocales={available}
  title={entry.data.title}
  description={entry.data.description}
>
  <article class="u-container article">
    <header class="head">
      <h1>{entry.data.title}</h1>
      <p class="meta u-sans u-muted">
        <time datetime={isoDate(entry.data.date)}>{formatDate(locale, entry.data.date)}</time>
        {entry.data.location && <><span aria-hidden="true">·</span><span>{entry.data.location}</span></>}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      entry.data.media.length > 0 && (
        <ul role="list" class="media">
          {entry.data.media.map((item) =>
            item.type === 'image' ? (
              <li><img src={item.src} alt={item.alt ?? ''} loading="lazy" /></li>
            ) : (
              <li>
                <video src={item.src} poster={item.poster} controls preload="metadata">
                  <track kind="captions" />
                </video>
              </li>
            ),
          )}
        </ul>
      )
    }

    <nav class="adjacent u-sans" aria-label={t(locale, 'nav.moments')}>
      {older ? (
        <a href={localeUrl(locale, `moments/${entrySlug(older.id)}`)} rel="next">
          ← {t(locale, 'moments.next')}
        </a>
      ) : (
        <span aria-disabled="true" class="adjacent__disabled">← {t(locale, 'moments.next')}</span>
      )}
      {newer ? (
        <a href={localeUrl(locale, `moments/${entrySlug(newer.id)}`)} rel="prev">
          {t(locale, 'moments.prev')} →
        </a>
      ) : (
        <span aria-disabled="true" class="adjacent__disabled">{t(locale, 'moments.prev')} →</span>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .article {
    display: grid;
    gap: var(--space-8);
    max-width: 48rem;
  }

  .head {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
    border-bottom: var(--line-hair) solid var(--color-line);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .media {
    display: grid;
    gap: var(--space-4);
  }

  .media img,
  .media video {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
  }

  .adjacent {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-top: var(--space-8);
    border-top: var(--line-hair) solid var(--color-line);
    font-size: var(--text-sm);
  }

  .adjacent__disabled {
    color: var(--color-muted);
    opacity: 0.4;
  }
</style>
