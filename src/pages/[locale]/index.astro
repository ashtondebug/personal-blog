---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_NAME } from '../../config/site';
import { LOCALES, getLocaleDefinition, type Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';
import { localeUrl } from '../../i18n/url';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale: locale.code } }));
}

const locale = Astro.params.locale as Locale;
const definition = getLocaleDefinition(locale);
const languageLinks = LOCALES.map((item) => ({
  ...item,
  href: localeUrl(item.code),
  current: item.code === definition.code,
}));
---
<BaseLayout locale={locale}>
  <main>
    <h1>{SITE_NAME}</h1>
    <p>{t(locale, 'site.tagline')}</p>
    <p>{t(locale, 'home.status')}</p>

    <nav aria-label={t(locale, 'home.languageHint')}>
      <p>{t(locale, 'home.languageHint')}</p>
      <ul>
        {
          languageLinks.map((item) => (
            <li>
              {item.current ? (
                <strong aria-current="page">{item.label}</strong>
              ) : (
                <a href={item.href} hreflang={item.htmlLang} lang={item.htmlLang}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </main>
</BaseLayout>
