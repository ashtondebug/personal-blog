---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TableOfContents from '../../../components/blog/TableOfContents.astro';
import ReadingProgress from '../../../components/blog/ReadingProgress.astro';
import Share from '../../../components/blog/Share.astro';
import { getCollection, render } from 'astro:content';
import type { Locale } from '../../../i18n/config';
import { t, tFormat } from '../../../i18n/ui';
import { localeUrl } from '../../../i18n/url';
import {
  buildTranslations,
  entryLocale,
  entrySlug,
  published,
  readingMinutes,
} from '../../../lib/content';
import { formatDate, isoDate } from '../../../lib/format';
import Comments from '../../../components/comments/Comments.astro';
import { COMMENTS_READY, commentPath } from '../../../config/comments';
import '../../../styles/prose.css';

type BlogEntry = Awaited<ReturnType<typeof getCollection<'blog'>>>[number];

export async function getStaticPaths() {
  const all = await getCollection('blog');
  return published(all).map((entry) => ({
    params: { locale: entryLocale(entry.id), slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: BlogEntry };
const locale: Locale = entryLocale(entry.id);

const { Content, headings } = await render(entry);
const minutes = readingMinutes(entry.body);

// 多语言版本：同一 translationKey 下各语言的真实 slug（可能不同）
const all = await getCollection('blog');
const translations = buildTranslations(all);
const group = entry.data.translationKey ? translations.get(entry.data.translationKey) : undefined;

const available = group ? [...group.keys()] : [locale];
const alternatePaths: Partial<Record<Locale, string>> = {};
if (group) {
  for (const [code, item] of group) {
    alternatePaths[code] = `blog/${entrySlug(item.id)}`;
  }
}
---
<BaseLayout
  locale={locale}
  path="blog"
  alternatePaths={alternatePaths}
  availableLocales={available}
  title={entry.data.title}
  description={entry.data.description}
  indexable
>
  <ReadingProgress />

  <div class="u-container layout">
    <article class="article" data-reading-article>
      <header class="head">
        <h1>{entry.data.title}</h1>
        <p class="meta u-sans u-muted">
          <time datetime={isoDate(entry.data.date)}>{formatDate(locale, entry.data.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{tFormat(locale, 'blog.readingTime', { n: minutes })}</span>
          {
            entry.data.updated && (
              <>
                <span aria-hidden="true">·</span>
                <span>{tFormat(locale, 'blog.updated', { date: formatDate(locale, entry.data.updated) })}</span>
              </>
            )
          }
        </p>
      </header>

      <div class="prose">
        <Content />
      </div>

      <div class="actions">
        <Share locale={locale} />
      </div>

      {COMMENTS_READY && <Comments locale={locale} path={commentPath(Astro.url.pathname, import.meta.env.BASE_URL)} />}

      <footer class="foot">
        <a href={localeUrl(locale, 'blog')}>{t(locale, 'blog.backToList')}</a>
      </footer>
    </article>

    {entry.data.toc && <TableOfContents locale={locale} headings={headings} />}
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-12);
    align-items: start;
  }

  .article {
    display: grid;
    gap: var(--space-8);
    max-width: 48rem;
  }

  .head {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
    border-bottom: var(--line-hair) solid var(--color-line);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .actions {
    padding-top: var(--space-4);
    border-top: var(--line-hair) solid var(--color-line);
  }

  .foot {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    padding-top: var(--space-6);
    border-top: var(--line-hair) solid var(--color-line);
  }

  @media (min-width: 1100px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 14rem;
    }
  }
</style>
