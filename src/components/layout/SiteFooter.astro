---
import { SITE_NAME } from '../../config/site';
import { FOOTER_NAV } from '../../config/nav';
import { localeUrl } from '../../i18n/url';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="u-container footer__inner">
    <div class="footer__about">
      <p class="footer__brand">{SITE_NAME}</p>
      <p class="footer__text u-muted">{t(locale, 'site.tagline')}</p>
    </div>

    <nav class="footer__nav" aria-label={t(locale, 'nav.primary')}>
      <ul role="list" class="footer__list">
        {
          FOOTER_NAV.map((item) =>
            item.enabled ? (
              <li>
                <a class="footer__link" href={localeUrl(locale, item.path)}>
                  {t(locale, item.key)}
                </a>
              </li>
            ) : (
              <li>
                <span class="footer__link footer__link--pending" aria-disabled="true">
                  {t(locale, item.key)}
                </span>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <p class="footer__meta u-muted">
      <span>© {year} {SITE_NAME}</span>
      <span>·</span>
      <span>{t(locale, 'footer.note')}</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-24);
    border-top: var(--line-hair) solid var(--color-line);
    font-family: var(--font-sans);
    padding-block: var(--space-12) var(--space-16);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-6);
    font-size: var(--text-sm);
  }

  .footer__brand {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .footer__text {
    font-size: var(--text-sm);
  }

  .footer__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
  }

  .footer__link {
    color: var(--color-muted);
    text-decoration: none;
  }

  a.footer__link:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  .footer__link--pending {
    opacity: 0.38;
    cursor: default;
  }

  .footer__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  @media (min-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr auto;
      align-items: start;
    }

    .footer__meta {
      grid-column: 1 / -1;
    }
  }
</style>
