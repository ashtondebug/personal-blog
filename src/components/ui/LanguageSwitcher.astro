---
import { LOCALES, type Locale } from '../../i18n/config';
import { localeUrl } from '../../i18n/url';
import { t } from '../../i18n/ui';

interface Props {
  locale: Locale;
  /** 当前版块路径（不含语言段），切换语言时保持同一版块 */
  path?: string;
  /** 内容页用：按语言给出真实路径（不同语言可能不同 slug） */
  alternatePaths?: Partial<Record<Locale, string>>;
  /** 该页面真实存在的语言；缺省视为全部存在 */
  availableLocales?: Locale[];
}

const { locale, path = '', alternatePaths, availableLocales } = Astro.props;
const available = availableLocales ?? LOCALES.map((item) => item.code);

const links = LOCALES.map((item) => ({
  code: item.code,
  label: item.label,
  htmlLang: item.htmlLang,
  href: localeUrl(item.code, alternatePaths?.[item.code] ?? path),
  current: item.code === locale,
  // 不存在的语言版本不生成可点击链接（禁止伪翻译入口）
  available: available.includes(item.code),
}));
---
<nav class="lang" aria-label={t(locale, 'lang.label')}>
  <ul role="list" class="lang__list">
    {
      links.map((item) => (
        <li>
          {item.current ? (
            <span class="lang__item lang__item--current" aria-current="true">
              {item.label}
            </span>
          ) : item.available ? (
            <a class="lang__item" href={item.href} hreflang={item.htmlLang} lang={item.htmlLang}>
              {item.label}
            </a>
          ) : (
            <span class="lang__item lang__item--unavailable" aria-disabled="true">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .lang {
    font-family: var(--font-sans);
  }

  .lang__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .lang__item {
    display: inline-block;
    padding-block: var(--space-1);
    text-decoration: none;
    color: var(--color-muted);
    white-space: nowrap;
  }

  a.lang__item:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .lang__item--current {
    color: var(--color-text);
    font-weight: 600;
  }

  .lang__item--unavailable {
    opacity: 0.4;
    cursor: not-allowed;
  }
</style>
