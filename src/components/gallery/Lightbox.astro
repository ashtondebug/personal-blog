---
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---
<div class="lightbox" data-lightbox-root hidden>
  <div class="lightbox__backdrop" data-lightbox-close aria-hidden="true"></div>

  <figure
    class="lightbox__panel"
    role="dialog"
    aria-modal="true"
    aria-label={t(locale, 'nav.gallery')}
    tabindex="-1"
    data-lightbox-panel
  >
    <img class="lightbox__image" data-lightbox-image alt="" />
    <figcaption class="lightbox__caption u-sans u-muted" data-lightbox-caption></figcaption>

    <div class="lightbox__controls u-sans">
      <button type="button" class="lightbox__button" data-lightbox-prev aria-label={t(locale, 'lightbox.prev')}>
        ←
      </button>
      <button type="button" class="lightbox__button" data-lightbox-close aria-label={t(locale, 'lightbox.close')}>
        ✕
      </button>
      <button type="button" class="lightbox__button" data-lightbox-next aria-label={t(locale, 'lightbox.next')}>
        →
      </button>
    </div>
  </figure>
</div>

<script>
  import '../../scripts/lightbox';
</script>

<style>
  .lightbox[hidden] {
    display: none;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    display: grid;
    place-items: center;
    padding: var(--space-4);
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(3px);
  }

  .lightbox__panel {
    position: relative;
    display: grid;
    gap: var(--space-3);
    max-width: min(72rem, 100%);
    max-height: 92vh;
    justify-items: center;
  }

  .lightbox__panel:focus-visible {
    outline: var(--line-bold) solid currentColor;
    outline-offset: var(--space-2);
  }

  .lightbox__image {
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
  }

  .lightbox__caption {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-align: center;
  }

  .lightbox__controls {
    display: flex;
    gap: var(--space-2);
  }

  .lightbox__button {
    min-width: 2.75rem;
    min-height: 2.75rem;
    border: var(--line-hair) solid var(--color-line);
    border-radius: var(--radius-sm);
    color: var(--color-text);
  }

  .lightbox__button:hover {
    border-color: var(--color-text);
  }

  /* 无 JS 时隐藏整个浮层（图片链接本身仍可点开原图） */
  :global(html:not(.js) .lightbox) {
    display: none;
  }
</style>
