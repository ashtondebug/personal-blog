---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/comments/Comments.astro';
import { COMMENTS_READY, GUESTBOOK_PATH } from '../../config/comments';
import { LOCALES, type Locale } from '../../i18n/config';
import { t } from '../../i18n/ui';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale: locale.code } }));
}

const locale = Astro.params.locale as Locale;
---
<BaseLayout locale={locale} path="guestbook" title={t(locale, 'nav.guestbook')}>
  <div class="u-container guestbook">
    <h1>{t(locale, 'nav.guestbook')}</h1>

    {
      COMMENTS_READY ? (
        <Comments locale={locale} path={GUESTBOOK_PATH} />
      ) : (
        <>
          <p class="u-muted u-sans">{t(locale, 'guestbook.placeholder')}</p>
          <p class="note u-sans u-muted">
            留言板以固定页面标识挂载 Waline，与文章评论互不干扰；服务端地址就绪后本页会自动出现评论区。
          </p>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .guestbook {
    display: grid;
    gap: var(--space-6);
    max-width: 42rem;
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .note {
    font-size: var(--text-sm);
    padding-top: var(--space-6);
    border-top: var(--line-hair) solid var(--color-line);
  }
</style>
