---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { LOCALES, type Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { localeUrl } from '../../../i18n/url';
import { byLocale, entrySlug, published, sortByDateDesc } from '../../../lib/content';

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale: locale.code } }));
}

const locale = Astro.params.locale as Locale;
const all = await getCollection('projects');
const projects = sortByDateDesc(byLocale(published(all), locale));
---
<BaseLayout locale={locale} path="projects" title={t(locale, 'nav.projects')}>
  <div class="u-container list">
    <h1>{t(locale, 'nav.projects')}</h1>

    {
      projects.length === 0 ? (
        <p class="u-muted u-sans">{t(locale, 'taxonomy.empty')}</p>
      ) : (
        <ul role="list" class="cards">
          {projects.map((project) => (
            <li class="card">
              <a class="card__title" href={localeUrl(locale, `projects/${entrySlug(project.id)}`)}>
                {project.data.title}
              </a>
              <p class="card__desc">{project.data.description}</p>
              <ul role="list" class="stack u-sans">
                {project.data.stack.map((item) => (
                  <li class="stack__item">{item}</li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .list {
    display: grid;
    gap: var(--space-8);
    max-width: 60rem;
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
  }

  .card {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
    border: var(--line-hair) solid var(--color-line);
    border-radius: var(--radius-md);
  }

  .card__title {
    font-size: var(--text-xl);
    text-decoration: none;
  }

  .card__title:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .card__desc {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .stack__item {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
    border: var(--line-hair) solid var(--color-line);
    border-radius: var(--radius-sm);
    padding: var(--space-1) var(--space-2);
  }
</style>
