---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { localeUrl } from '../../../i18n/url';
import { entryLocale, entrySlug, published } from '../../../lib/content';
import { formatDate } from '../../../lib/format';
import Lightbox from '../../../components/gallery/Lightbox.astro';
import '../../../styles/prose.css';

type GalleryEntry = Awaited<ReturnType<typeof getCollection<'gallery'>>>[number];

export async function getStaticPaths() {
  const all = await getCollection('gallery');
  return published(all).map((entry) => ({
    params: { locale: entryLocale(entry.id), slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: GalleryEntry };
const locale: Locale = entryLocale(entry.id);
const { Content } = await render(entry);

const facts = [
  entry.data.camera && { label: 'Camera', value: entry.data.camera },
  entry.data.lens && { label: 'Lens', value: entry.data.lens },
  entry.data.location && { label: t(locale, 'gallery.meta'), value: entry.data.location },
  entry.data.shotAt && { label: 'Shot', value: formatDate(locale, entry.data.shotAt) },
].filter(Boolean) as { label: string; value: string }[];
---
<BaseLayout
  locale={locale}
  path="gallery"
  title={entry.data.title}
  description={entry.data.description}
  keywords={[entry.data.category, ...entry.data.tags]}
>
  <article class="u-container article">
    <header class="head">
      <h1>{entry.data.title}</h1>
      <p class="u-muted u-sans">{entry.data.description}</p>
    </header>

    <ul role="list" class="grid">
      {
        entry.data.images.map((image) => (
          <li class="grid__item">
            <a
              href={image.src}
              rel="noopener noreferrer"
              data-lightbox
              data-gallery={entrySlug(entry.id)}
              data-caption={image.caption ?? image.alt}
              data-alt={image.alt}
            >
              <img
                src={image.src}
                alt={image.alt}
                width={image.width}
                height={image.height}
                loading="lazy"
              />
            </a>
            {image.caption && <p class="caption u-sans u-muted">{image.caption}</p>}
          </li>
        ))
      }
    </ul>

    <div class="prose">
      <Content />
    </div>

    {
      facts.length > 0 && (
        <dl class="facts u-sans">
          {facts.map((fact) => (
            <div class="facts__row">
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <footer class="foot u-sans">
      <a href={localeUrl(locale, 'gallery')}>{t(locale, 'nav.gallery')} →</a>
    </footer>
  </article>
  <Lightbox locale={locale} />
</BaseLayout>

<style>
  .article {
    display: grid;
    gap: var(--space-8);
    max-width: 72rem;
  }

  .head {
    display: grid;
    gap: var(--space-3);
    padding-bottom: var(--space-6);
    border-bottom: var(--line-hair) solid var(--color-line);
    max-width: 48rem;
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-6);
    align-items: start;
  }

  .grid__item img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
  }

  .caption {
    font-size: var(--text-xs);
    margin-top: var(--space-2);
  }

  .facts {
    display: grid;
    gap: var(--space-2);
    max-width: 48rem;
    font-size: var(--text-sm);
  }

  .facts__row {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-2);
    border-bottom: var(--line-hair) solid var(--color-line);
  }

  dt {
    color: var(--color-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .foot {
    font-size: var(--text-sm);
    padding-top: var(--space-6);
    border-top: var(--line-hair) solid var(--color-line);
  }
</style>
