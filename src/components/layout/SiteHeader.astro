---
import { SITE_NAME } from '../../config/site';
import { PRIMARY_NAV } from '../../config/nav';
import { localeUrl } from '../../i18n/url';
import { t } from '../../i18n/ui';
import type { Locale } from '../../i18n/config';
import LanguageSwitcher from '../ui/LanguageSwitcher.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  locale: Locale;
  /** 用于导航高亮（404 等页面可传哨兵值表示"不高亮任何项"） */
  navPath?: string;
  /** 用于生成语言切换链接；缺省与 navPath 相同 */
  switchPath?: string;
  /** 内容页用：按语言给出真实路径 */
  alternatePaths?: Partial<Record<Locale, string>>;
  availableLocales?: Locale[];
}

const { locale, navPath = '', switchPath, alternatePaths, availableLocales } = Astro.props;
const switchTarget = switchPath ?? navPath;
---
<header class="header">
  <div class="u-container header__inner">
    <a class="header__brand" href={localeUrl(locale)}>{SITE_NAME}</a>

    <nav class="nav" aria-label={t(locale, 'nav.primary')}>
      <ul role="list" class="nav__list">
        {
          PRIMARY_NAV.map((item) => (
            <li>
              {item.enabled ? (
                <a
                  class="nav__link"
                  href={localeUrl(locale, item.path)}
                  aria-current={item.path === navPath ? 'page' : undefined}
                >
                  {t(locale, item.key)}
                </a>
              ) : (
                <span class="nav__link nav__link--pending" aria-disabled="true">
                  {t(locale, item.key)}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__controls">
      <MobileMenu locale={locale} navPath={navPath} />
      <a
        class="header__search"
        href={localeUrl(locale, 'search')}
        data-search-open
        aria-label={t(locale, 'search.open')}
      >
        <span aria-hidden="true">⌕</span>
        <span class="header__search-text">{t(locale, 'search.open')}</span>
      </a>
      <LanguageSwitcher
        locale={locale}
        path={switchTarget}
        alternatePaths={alternatePaths}
        availableLocales={availableLocales}
      />
      <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: var(--color-bg);
    border-bottom: var(--line-hair) solid var(--color-line);
    font-family: var(--font-sans);
  }

  /* 移动端菜单面板以 header 为定位基准 */
  .header__inner {
    position: relative;
  }

  @media (max-width: 899px) {
    .nav {
      display: none;
    }
  }

  .header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-3);
  }

  .header__brand {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .nav {
    flex: 1 1 100%;
    order: 3;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav::-webkit-scrollbar {
    display: none;
  }

  .nav__list {
    display: flex;
    gap: var(--space-4);
    white-space: nowrap;
  }

  .nav__link {
    display: inline-block;
    padding-block: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-decoration: none;
    border-bottom: var(--line-hair) solid transparent;
  }

  a.nav__link:hover {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .nav__link[aria-current='page'] {
    color: var(--color-text);
    border-bottom-color: var(--color-text);
  }

  .nav__link--pending {
    opacity: 0.38;
    cursor: default;
  }

  .header__controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-inline-start: auto;
  }

  .header__search {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    padding-inline: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-muted);
    text-decoration: none;
  }

  .header__search:hover {
    color: var(--color-text);
  }

  .header__search-text {
    display: none;
  }

  @media (min-width: 900px) {
    .header__search-text {
      display: inline;
    }
  }

  @media (min-width: 900px) {
    .header__inner {
      flex-wrap: nowrap;
    }

    .nav {
      flex: 0 1 auto;
      order: 2;
    }

    .header__controls {
      order: 3;
    }
  }
</style>
