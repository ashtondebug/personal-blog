---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { Locale } from '../../../i18n/config';
import { t } from '../../../i18n/ui';
import { localeUrl } from '../../../i18n/url';
import {
  buildBacklinks,
  buildTranslations,
  byLocale,
  entryLocale,
  entrySlug,
  published,
} from '../../../lib/content';
import { formatDate, isoDate } from '../../../lib/format';
import '../../../styles/prose.css';

type KnowledgeEntry = Awaited<ReturnType<typeof getCollection<'knowledge'>>>[number];

export async function getStaticPaths() {
  const all = await getCollection('knowledge');
  return published(all).map((entry) => ({
    params: { locale: entryLocale(entry.id), slug: entrySlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: KnowledgeEntry };
const locale: Locale = entryLocale(entry.id);

const { Content } = await render(entry);

const all = await getCollection('knowledge');
const sameLocale = byLocale(all, locale);
const translations = buildTranslations(all);
const group = entry.data.translationKey ? translations.get(entry.data.translationKey) : undefined;
const available = group ? [...group.keys()] : [locale];

const alternatePaths: Partial<Record<Locale, string>> = {};
if (group) {
  for (const [code, item] of group) alternatePaths[code] = `knowledge/${entrySlug(item.id)}`;
}

/** 反向链接：找引用了我（slug 或别名）的条目 */
const backlinks = buildBacklinks(sameLocale);
const myKeys = [entrySlug(entry.id), ...(entry.data.aliases ?? [])];
const referring = [
  ...new Map(
    myKeys.flatMap((key) => backlinks.get(key) ?? []).map((item) => [item.id, item]),
  ).values(),
].filter((item) => item.id !== entry.id);
---
<BaseLayout
  locale={locale}
  path="knowledge"
  alternatePaths={alternatePaths}
  availableLocales={available}
  title={entry.data.title}
  description={entry.data.description}
>
  <article class="u-container article">
    <header class="head">
      <h1>{entry.data.title}</h1>
      <p class="meta u-sans u-muted">
        <time datetime={isoDate(entry.data.date)}>{formatDate(locale, entry.data.date)}</time>
        {entry.data.section && <><span aria-hidden="true">·</span><span>{entry.data.section}</span></>}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      referring.length > 0 && (
        <aside class="panel" aria-labelledby="backlinks">
          <h2 id="backlinks" class="panel__title u-sans">{t(locale, 'knowledge.backlinks')}</h2>
          <ul role="list" class="panel__list">
            {referring.map((item) => (
              <li>
                <a href={localeUrl(locale, `knowledge/${entrySlug(item.id)}`)}>{item.data.title}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    {
      entry.data.related.length > 0 && (
        <aside class="panel" aria-labelledby="related">
          <h2 id="related" class="panel__title u-sans">{t(locale, 'knowledge.related')}</h2>
          <ul role="list" class="panel__list">
            {entry.data.related.map((target) => (
              <li><a href={localeUrl(locale, `knowledge/${target}`)}>{target}</a></li>
            ))}
          </ul>
        </aside>
      )
    }

    <footer class="foot u-sans">
      <a href={localeUrl(locale, 'knowledge')}>{t(locale, 'nav.knowledge')} →</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article {
    display: grid;
    gap: var(--space-8);
    max-width: 48rem;
  }

  .head {
    display: grid;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
    border-bottom: var(--line-hair) solid var(--color-line);
  }

  h1 {
    font-size: var(--text-3xl);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }

  .panel {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-6);
    border-top: var(--line-hair) solid var(--color-line);
  }

  .panel__title {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .panel__list {
    display: grid;
    gap: var(--space-2);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
  }

  .foot {
    font-size: var(--text-sm);
    padding-top: var(--space-8);
    border-top: var(--line-hair) solid var(--color-line);
  }
</style>
